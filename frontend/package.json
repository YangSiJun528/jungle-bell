{
  "name": "jungle-bell-frontend",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev:web": "vite --mode web",
    "dev:desktop-ui": "vite --mode desktop",
    "build:web": "npm run typecheck && vite build --mode web && node scripts/verify-build-artifact.mjs web",
    "build:desktop-ui": "npm run typecheck && vite build --mode desktop && node scripts/verify-build-artifact.mjs desktop",
    "desktop:dev": "cd ../desktop && tauri dev",
    "desktop:build": "cd ../desktop && tauri build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:web": "npm run build:web && npm test",
    "verify:desktop": "npm run build:desktop-ui && cargo fmt --manifest-path ../desktop/Cargo.toml --check && cargo test --manifest-path ../desktop/Cargo.toml --all-targets && cargo clippy --manifest-path ../desktop/Cargo.toml --all-targets -- -D warnings",
    "verify": "npm run verify:web && npm run verify:desktop",
    "preview:web": "vite preview --mode web",
    "tauri": "cd ../desktop && tauri"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
