{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["settings", "checker", "attendance", "onboarding", "campus"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "notification:default",
    "dialog:default",
    "allow-report-attendance-status",
    "allow-report-checker-ready",
    "allow-report-cms-identity",
    "allow-log-from-js",
    "allow-get-auto-update",
    "allow-set-auto-update",
    "allow-get-app-version",
    "allow-report-campus-ready",
    "allow-refresh-campus-data",
    "allow-load-meal-history",
    "allow-open-image-viewer",
    "allow-get-pending-update",
    "allow-check-and-notify-update",
    "allow-get-auto-start",
    "allow-set-auto-start",
    "allow-get-start-notification-enabled",
    "allow-set-start-notification-enabled",
    "allow-get-end-notification-enabled",
    "allow-set-end-notification-enabled",
    "allow-get-start-notification-interval",
    "allow-set-start-notification-interval",
    "allow-get-end-notification-interval",
    "allow-set-end-notification-interval",
