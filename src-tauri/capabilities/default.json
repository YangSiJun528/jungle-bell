{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["settings", "checker", "attendance", "onboarding", "campus"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "notification:default",
    "dialog:default",
    "allow-report-attendance-status",
    "allow-report-checker-ready",
    "allow-report-cms-identity",
    "allow-log-from-js",
    "allow-get-settings-snapshot",
    "allow-resolve-cohort-selection",
    "allow-set-selected-cohort",
    "allow-set-auto-update",
    "allow-report-campus-ready",
    "allow-report-campus-interaction",
    "allow-refresh-campus-data",
    "allow-load-meal-history",
    "allow-open-image-viewer",
    "allow-check-and-notify-update",
    "allow-set-auto-start",
    "allow-set-start-notification-enabled",
    "allow-set-end-notification-enabled",
    "allow-set-meal-subscription-enabled",
    "allow-set-laundry-watch",
    "allow-set-start-notification-interval",
    "allow-set-end-notification-interval",
    "allow-set-notification-start",
    "allow-set-notification-end",
    "allow-set-skip-attendance",
    "allow-set-skip-sunday",
    "allow-open-notification-settings",
    "allow-set-debug-mode",
    "allow-get-usage-analytics-enabled",
    "allow-set-usage-analytics-enabled",
    "allow-set-show-dday",
    "allow-set-show-app-icon",
    "allow-open-log-folder",
    "allow-open-onboarding",
    "allow-complete-onboarding",
    "allow-open-attendance-window",
    "allow-get-attendance-cohort-id",
    "allow-report-attendance-start-clicked",
    "allow-get-local-dashboard-snapshot",
    "allow-dismiss-meal-alert",
    "allow-get-login-status",
    "allow-refresh-login-status"
  ]
}
