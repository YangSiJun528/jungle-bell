    "allow-set-skip-attendance",
    "allow-get-skip-sunday",
    "allow-set-skip-sunday",
    "allow-open-notification-settings",
    "allow-get-debug-mode",
    "allow-set-debug-mode",
    "allow-get-usage-analytics-enabled",
    "allow-set-usage-analytics-enabled",
    "allow-get-show-dday",
    "allow-set-show-dday",
    "allow-get-show-app-icon",
    "allow-set-show-app-icon",
    "allow-open-log-folder",
    "allow-open-onboarding",
    "allow-complete-onboarding",
    "allow-open-attendance-window",
    "allow-get-login-status",
    "allow-refresh-login-status"
