{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray-panel",
  "description": "Minimal permissions for the custom tray panel",
  "windows": ["tray-panel"],
  "permissions": [
    "core:event:allow-listen",
    "allow-get-tray-panel-state",
    "allow-get-local-dashboard-snapshot",
    "allow-set-laundry-watch",
    "allow-run-tray-panel-action",
    "allow-hide-tray-panel",
    "allow-get-news-feed",
    "allow-open-news-item",
    "allow-get-notification-inbox-snapshot",
    "allow-activate-notification"
  ]
}
