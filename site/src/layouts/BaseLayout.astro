---
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    canonicalPath?: string;
}

const {title, description, canonicalPath} = Astro.props;
const routePath = canonicalPath ?? (Astro.url.pathname.endsWith('/')
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname);
const assetPath = routePath.endsWith('.html') ? routePath : `${routePath}/index.html`;
const canonical = new URL(assetPath, Astro.site);
---

<!doctype html>
<html lang="ko">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f5f7f3" />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" type="application/rss+xml" title="Jungle Bell 이야기" href="/blog/rss.xml" />
        <title>{title}</title>
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href="/blog/index.html" aria-label="Jungle Bell 이야기 홈">
                <span class="brand-mark" aria-hidden="true">J</span>
                <span>
                    <strong>Jungle Bell</strong>
                    <small>이야기</small>
                </span>
            </a>
            <nav aria-label="주요 메뉴">
                <a href="/dashboard.html#home">대시보드</a>
                <a href="/blog/rss.xml">RSS</a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer>
            <span>Jungle Bell</span>
            <span>Markdown으로 관리되는 공식 소식</span>
        </footer>
    </body>
</html>
