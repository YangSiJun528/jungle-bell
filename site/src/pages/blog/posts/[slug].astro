---
import {render, type CollectionEntry} from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {publishedPosts} from '../../../lib/posts';

export async function getStaticPaths() {
    const posts = await publishedPosts();
    return posts.map((post) => ({params: {slug: post.id}, props: {post}}));
}

interface Props { post: CollectionEntry<'posts'> }
const {post} = Astro.props;
const {Content} = await render(post);
const dateFormatter = new Intl.DateTimeFormat('ko-KR', {dateStyle: 'long', timeZone: 'Asia/Seoul'});
---

<BaseLayout title={`${post.data.title} · Jungle Bell`} description={post.data.description}>
    <article>
        <header class="article-header">
            <div class="post-meta">
                <span class="category">{post.data.category}</span>
                <time datetime={post.data.publishedAt.toISOString()}>
                    {dateFormatter.format(post.data.publishedAt)}
                </time>
            </div>
            <h1>{post.data.title}</h1>
            <p class="article-description">{post.data.description}</p>
        </header>
        <div class="article-body"><Content /></div>
        <a class="back-link" href="/blog/index.html">← 모든 소식 보기</a>
        <a hidden href="/blog/api/posts.json">JSON 목록</a>
    </article>
</BaseLayout>
