{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard",
  "description": "Minimal native capability for the local dashboard",
  "windows": ["dashboard"],
  "permissions": [
    "core:event:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/YangSiJun528/jungle-bell" },
        {
          "url": "https://github.com/YangSiJun528/jungle-bell#%EC%84%A4%EC%B9%98"
        },
        { "url": "https://github.com/YangSiJun528/jungle-bell/issues/new/choose" },
        { "url": "https://github.com/YangSiJun528/jungle-bell/releases/latest" },
        { "url": "https://jungle-lms.krafton.com/check-in" },
        { "url": "https://pf.kakao.com/_xhzNjn/*" },
        {
          "url": "https://jungle-bell.sijun-yang.com/api/public/assets/*"
        }
      ]
    },
    "allow-bootstrap-desktop-http-session",
    "allow-get-desktop-settings",
    "allow-check-desktop-update",
    "allow-install-desktop-update",
    "allow-update-desktop-settings",
    "allow-open-log-folder",
    "allow-open-system-notification-settings",
    "allow-get-connected-service-status",
    "allow-reset-desktop-identity",
    "allow-open-lms-login",
    "allow-refresh-platform-sync",
    "allow-get-notification-inbox-snapshot",
    "allow-mark-notification-read",
    "allow-mark-all-notifications-read",
    "allow-activate-notification",
    "allow-send-test-notification"
  ]
}
