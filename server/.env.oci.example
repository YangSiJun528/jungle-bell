JOBS_IMAGE=jungle-bell-jobs:latest
JOBS_D1_GATEWAY_URL=https://jungle-bell-api.yangsijun5528.workers.dev/internal/jobs/d1
LAUNDRY_URL=https://laundry.example.com/api/status
MEALS_EVERY_MINUTES=5
D1_GATEWAY_TIMEOUT_MS=30000
D1_GATEWAY_RETRIES=3
REQUEST_TIMEOUT_MS=30000
REQUEST_RETRIES=2

# These files must exist on the OCI host with mode 0600.
JOBS_D1_GATEWAY_SECRET_FILE=/home/ubuntu/.config/jungle-bell-jobs/jobs-d1-gateway-secret
VAPID_PUBLIC_KEY_FILE=/home/ubuntu/.config/jungle-bell-jobs/vapid-public-key
VAPID_PRIVATE_KEY_FILE=/home/ubuntu/.config/jungle-bell-jobs/vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Optional device-profile override.
# LG_RUN_STATES=POWER_OFF,INITIAL,RUNNING,RINSING,SPINNING,END,ERROR
