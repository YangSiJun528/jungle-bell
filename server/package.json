{
  "name": "@jungle-bell/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:local",
    "build:local": "tsup apps/local-collector/src/index.ts --format esm --platform node --target node22 --out-dir dist/local --clean",
    "check": "npm run typecheck && npm test",
    "dev:api": "wrangler dev --config workers/api-worker/wrangler.jsonc",
    "dev:collector": "wrangler dev --config workers/collector-worker/wrangler.jsonc",
    "deploy:api": "wrangler deploy --config workers/api-worker/wrangler.jsonc",
    "deploy:collector": "wrangler deploy --config workers/collector-worker/wrangler.jsonc",
    "d1:migrate:local": "wrangler d1 migrations apply jungle-bell-data --local --config workers/collector-worker/wrangler.jsonc",
    "d1:migrate:remote": "wrangler d1 migrations apply jungle-bell-data --remote --config workers/collector-worker/wrangler.jsonc",
    "local:collect": "node dist/local/index.js collect",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@logtape/file": "^2.0.11",
    "@logtape/logtape": "^2.0.11",
    "commander": "^14.0.2",
    "hono": "^4.11.4",
    "json-canonicalize": "^2.0.0",
    "ky": "^2.0.2",
    "write-file-atomic": "^7.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260717.1",
    "@types/node": "^24.10.1",
    "@types/write-file-atomic": "^4.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.59.2"
  },
  "engines": {
    "node": ">=22"
  }
}
