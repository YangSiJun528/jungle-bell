{
  "name": "@jungle-bell/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "apps/api-worker",
    "apps/jobs-runner"
  ],
  "scripts": {
    "build": "npm run build --workspace @jungle-bell/jobs-runner",
    "check": "npm run typecheck && npm test",
    "jobs:run": "npm run start --workspace @jungle-bell/jobs-runner",
    "dev:api": "npm run dev --workspace @jungle-bell/api-worker",
    "deploy:api": "npm run deploy --workspace @jungle-bell/api-worker",
    "deploy:api:test": "npm run deploy:test --workspace @jungle-bell/api-worker",
    "db:reset:local": "npm run db:reset:local --workspace @jungle-bell/api-worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:shared && npm run typecheck:api && npm run typecheck:jobs && npm run typecheck:tests",
    "typecheck:shared": "tsc --noEmit -p tsconfig.shared.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api-worker.json",
    "typecheck:jobs": "tsc --noEmit -p tsconfig.jobs-runner.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
