{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jungle-bell-api-harness-test",
  "main": "src/workers/api.ts",
  "compatibility_date": "2026-07-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jungle-bell-harness-test",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA_BUCKET",
      "bucket_name": "jungle-bell-harness-test"
    }
  ]
}
