{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jungle-bell-api",
  "main": "src/workers/api.ts",
  "compatibility_date": "2026-07-14",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../dist",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/v1/*", "/healthz"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jungle-bell-data",
      "database_id": "5b1d4841-3dbe-44a9-84f8-9fd032bd0d46"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA_BUCKET",
      "bucket_name": "jungle-bell-data"
    }
  ]
}
