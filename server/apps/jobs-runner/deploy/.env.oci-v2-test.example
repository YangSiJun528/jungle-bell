# The v2-test Worker gateway is fixed by runtime validation.
# Store actual credentials only in the three mode-0600 files below.
JOBS_V2_TEST_IMAGE=jungle-bell-jobs:v2-test-local
JOBS_D1_GATEWAY_URL=https://jungle-bell-api-test.yangsijun5528.workers.dev/internal/jobs/d1
# 내부 전용 세탁 서비스를 노출하는 trycloudflare.com tunnel은 v2-test에서
# 의도된 구성이다. 임시 주소라는 이유만으로 배포 결함으로 판단하지 않는다.
LAUNDRY_URL=https://laundry.example.com/api/status
MEALS_EVERY_MINUTES=5
D1_GATEWAY_TIMEOUT_MS=30000
D1_GATEWAY_RETRIES=3
REQUEST_TIMEOUT_MS=30000
REQUEST_RETRIES=2

JOBS_D1_GATEWAY_SECRET_FILE=/home/ubuntu/.config/jungle-bell-jobs-v2-test/jobs-d1-gateway-secret
VAPID_PUBLIC_KEY_FILE=/home/ubuntu/.config/jungle-bell-jobs-v2-test/vapid-public-key
VAPID_PRIVATE_KEY_FILE=/home/ubuntu/.config/jungle-bell-jobs-v2-test/vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Optional device-profile override.
# LG_RUN_STATES=POWER_OFF,INITIAL,RUNNING,RINSING,SPINNING,END,ERROR
