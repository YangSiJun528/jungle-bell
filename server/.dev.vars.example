# Copy this file to .dev.vars for `wrangler dev`. Wrangler loads either
# .dev.vars or .env, never both. Once .dev.vars exists, the Collector-only
# variables in server/.env are not exposed to the Worker and are not needed by
# the API Worker.
#
# Keep real local values only in ignored .dev.vars. Configure production secrets
# with `wrangler secret put`; do not commit them here or to server/.env.
PAIRING_SECRET=replace-with-at-least-32-random-bytes
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
JOBS_D1_GATEWAY_SECRET=replace-with-at-least-32-random-characters
