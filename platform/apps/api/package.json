{
  "name": "@jungle-bell/api",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:backup": "node dist/backup.js",
    "db:backup:dev": "tsx src/backup.ts",
    "dev": "cross-env NODE_ENV=development JB_ALLOW_DEV_BOOTSTRAP=true tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "node-cron": "^4.6.0",
    "tough-cookie": "^6.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
