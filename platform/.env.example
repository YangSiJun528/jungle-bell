# Public HTTPS origin that serves both the web app and browser-facing API.
JB_PUBLIC_ORIGIN=https://jungle-bell.example.com

# Bind the production API to all container interfaces.
HOST=0.0.0.0
PORT=8787

# Keep false in production. This endpoint only creates cookie sessions for tests.
JB_ALLOW_DEV_BOOTSTRAP=false

# Optional when using the provided container image.
JB_WEB_ROOT=/app/apps/web/dist

# Public campus source. The server keeps the last validated snapshot in SQLite.
JB_CAMPUS_DATA_API_URL=https://jungle-bell-api.yangsijun5528.workers.dev

# SQLite and local backups for the single-server deployment.
JB_DB_PATH=.data/jungle-bell.sqlite
JB_BACKUP_DIRECTORY=.data/backups

# The pairing transport key encrypts the short-lived mobile pairing handoff.
# It never stores an LMS access or refresh cookie. Development generates an
# ephemeral key when this is omitted. To persist local sessions, uncomment a
# canonical base64-encoded 32-byte value.
# JB_SESSION_ENCRYPTION_KEY=

# HMAC key used to pseudonymize the immutable LMS account ID once at enrollment.
# Development derives it from the pairing key when this is omitted.
# JB_IDENTITY_HMAC_KEY=

# Optional Web Push. Configure all three values together.
# JB_VAPID_SUBJECT=mailto:admin@example.com
# JB_VAPID_PUBLIC_KEY=
# JB_VAPID_PRIVATE_KEY=

# Set both to the same public HTTPS origin when building a production Tauri app.
# Development defaults are http://127.0.0.1:5173 and http://127.0.0.1:8787.
JB_APP_ORIGIN=https://jungle-bell.example.com
JB_API_ORIGIN=https://jungle-bell.example.com
