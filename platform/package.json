{
  "name": "jungle-bell-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @jungle-bell/api && npm run build -w @jungle-bell/web",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w @jungle-bell/api\" \"npm run dev -w @jungle-bell/web\"",
    "load:dummy": "k6 run scripts/load-dummy.js",
    "load:seed": "npm run build -w @jungle-bell/api && node scripts/seed-load.mjs",
    "smoke:platform": "npm run build && node scripts/smoke-platform.mjs",
    "smoke:load": "npm run build && node scripts/smoke-platform.mjs --k6",
    "smoke:campus-live": "npm run build && node scripts/smoke-platform.mjs --live-campus",
    "container:build:smoke": "docker build --tag jungle-bell-platform:smoke .",
    "smoke:container": "npm run container:build:smoke && node scripts/smoke-container.mjs",
    "test": "npm run test:ops && npm run test --workspaces --if-present",
    "test:ops": "node --test scripts/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm run test && npm run build && npm run tauri:check && npm run lint -w @jungle-bell/desktop && npm run release-check -w @jungle-bell/desktop",
    "tauri:check": "npm run typecheck -w @jungle-bell/desktop",
    "tauri:build": "npm run build -w @jungle-bell/desktop",
    "tauri:dev": "npm run dev -w @jungle-bell/desktop"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=24"
  }
}
