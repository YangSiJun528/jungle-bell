---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {postHref, publishedPosts} from '../../lib/posts';

const posts = await publishedPosts();
const dateFormatter = new Intl.DateTimeFormat('ko-KR', {dateStyle: 'long', timeZone: 'Asia/Seoul'});
---

<BaseLayout title="Jungle Bell 이야기" description="Jungle Bell의 업데이트와 이용 안내를 확인하세요.">
    <section class="hero">
        <p class="eyebrow">OFFICIAL UPDATES</p>
        <h1>Jungle Bell 이야기</h1>
        <p class="lead">서비스 업데이트, 점검 소식, PC 앱과 모바일 PWA 이용 안내를 정리합니다.</p>
    </section>

    {posts.length > 0 ? (
        <ol class="post-list">
            {posts.map((post) => (
                <li>
                    <a class="post-card" href={postHref(post)}>
                        <div class="post-meta">
                            <span class="category">{post.data.category}</span>
                            <time datetime={post.data.publishedAt.toISOString()}>
                                {dateFormatter.format(post.data.publishedAt)}
                            </time>
                        </div>
                        <h2>{post.data.title}</h2>
                        <p>{post.data.description}</p>
                    </a>
                </li>
            ))}
        </ol>
    ) : (
        <p class="empty">아직 등록된 소식이 없습니다.</p>
    )}
</BaseLayout>
